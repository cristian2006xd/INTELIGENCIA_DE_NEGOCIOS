<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>tDW_Fact_Disponibilidad</name>
    <description>Carga dw.fact_disponibilidad desde stg.mysql_disponibilidad, homologando sucursal_origen (nombre libre de MySQL) a codigo_sucursal igual que tMySQL_Reserva_Valida, y resolviendo pelicula y fecha de corte (fecha de la carga).</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
    <parameters>
    </parameters>
    <log>
      <trans-log-table>
        <connection/><schema/><table/><size_limit_lines/><interval/><timeout_days/>
      </trans-log-table>
      <perf-log-table>
        <connection/><schema/><table/><interval/><timeout_days/>
      </perf-log-table>
      <channel-log-table>
        <connection/><schema/><table/><timeout_days/>
      </channel-log-table>
      <step-log-table>
        <connection/><schema/><table/><timeout_days/>
      </step-log-table>
      <metrics-log-table>
        <connection/><schema/><table/><timeout_days/>
      </metrics-log-table>
    </log>
    <maxdate><connection/><table/><field/><offset>0.0</offset><maxdiff>0.0</maxdiff></maxdate>
    <size_rowset>10000</size_rowset>
    <sleep_time_empty>50</sleep_time_empty>
    <sleep_time_full>50</sleep_time_full>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <using_thread_priorities>Y</using_thread_priorities>
    <capture_step_performance>N</capture_step_performance>
    <step_performance_capturing_delay>1000</step_performance_capturing_delay>
    <step_performance_capturing_size_limit>100</step_performance_capturing_size_limit>
    <dependencies>
    </dependencies>
    <partitionschemas>
    </partitionschemas>
    <slaveservers>
    </slaveservers>
    <clusterschemas>
    </clusterschemas>
    <created_user>-</created_user>
    <created_date>2026/07/28 08:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/07/28 08:00:00.000</modified_date>
    <key_for_session_key/>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop><from>Leer_Disponibilidad</from><to>Homologar_Sucursal</to><enabled>Y</enabled></hop>
    <hop><from>Homologar_Sucursal</from><to>Filtro_Sucursal_Homologada</to><enabled>Y</enabled></hop>
    <hop><from>Filtro_Sucursal_Homologada</from><to>Lookup_Sucursal</to><enabled>Y</enabled></hop>
    <hop><from>Filtro_Sucursal_Homologada</from><to>Descartadas_Sin_Homologar</to><enabled>Y</enabled></hop>
    <hop><from>Lookup_Sucursal</from><to>Lookup_Pelicula</to><enabled>Y</enabled></hop>
    <hop><from>Lookup_Pelicula</from><to>Lookup_Fecha_Corte</to><enabled>Y</enabled></hop>
    <hop><from>Lookup_Fecha_Corte</from><to>Cargar_Fact_Disponibilidad</to><enabled>Y</enabled></hop>
  </order>

  <step>
    <name>Leer_Disponibilidad</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Stage</connection>
    <sql>SELECT
  TRIM(UPPER(sucursal_origen)) AS sucursal_norm,
  codigo_pelicula,
  funciones_disponibles,
  funciones_minimas,
  fecha_ultimo_movimiento,
  CURRENT_DATE AS fecha_corte,
  GREATEST(funciones_disponibles - funciones_minimas, 0) AS exceso_programacion,
  GREATEST(funciones_minimas - funciones_disponibles, 0) AS deficit_programacion
FROM stg.mysql_disponibilidad</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>80</xloc>
      <yloc>96</yloc>
      <draw>Y</draw>
    </GUI>
  </step>

  <step>
    <name>Homologar_Sucursal</name>
    <type>ValueMapper</type>
    <description>Mismo mapeo de nombres libres de MySQL a codigo_sucursal que tMySQL_Reserva_Valida.Homologar_Sucursal.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <field_to_use>sucursal_norm</field_to_use>
    <target_field>codigo_sucursal</target_field>
    <non_match_default>SIN_HOMOLOGAR</non_match_default>
    <fields>
      <field><source_value>CENTRO</source_value><target_value>CENTRO</target_value></field>
      <field><source_value>CINE CENTRO</source_value><target_value>CENTRO</target_value></field>
      <field><source_value>NORTE</source_value><target_value>NORTE</target_value></field>
      <field><source_value>CINE NORTE</source_value><target_value>NORTE</target_value></field>
      <field><source_value>SUR</source_value><target_value>SUR</target_value></field>
      <field><source_value>CINE SUR</source_value><target_value>SUR</target_value></field>
      <field><source_value>VALLE</source_value><target_value>VALLE</target_value></field>
      <field><source_value>CINE VALLE</source_value><target_value>VALLE</target_value></field>
    </fields>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>240</xloc>
      <yloc>96</yloc>
      <draw>Y</draw>
    </GUI>
  </step>

  <step>
    <name>Filtro_Sucursal_Homologada</name>
    <type>FilterRows</type>
    <description>Descarta filas cuya sucursal_origen no coincide con ninguna sucursal conocida, para evitar sucursal_key nulo en el hecho.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Lookup_Sucursal</send_true_to>
    <send_false_to>Descartadas_Sin_Homologar</send_false_to>
    <compare>
      <condition>
        <negated>Y</negated>
        <conditions>
        </conditions>
        <leftvalue>codigo_sucursal</leftvalue>
        <function>=</function>
        <rightvalue2/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>SIN_HOMOLOGAR</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask>String</mask>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>400</xloc>
      <yloc>96</yloc>
      <draw>Y</draw>
    </GUI>
  </step>

  <step>
    <name>Descartadas_Sin_Homologar</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>400</xloc>
      <yloc>240</yloc>
      <draw>Y</draw>
    </GUI>
  </step>

  <step>
    <name>Lookup_Sucursal</name>
    <type>DBLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Stage</connection>
    <cache>Y</cache>
    <cache_load_all>Y</cache_load_all>
    <cache_size>0</cache_size>
    <lookup>
      <schema>dw</schema>
      <table>dim_sucursal</table>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
      <key>
        <name>codigo_sucursal</name>
        <field>codigo_sucursal</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>sucursal_key</name>
        <rename>sucursal_key</rename>
        <default/>
        <type>Integer</type>
      </value>
    </lookup>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>560</xloc>
      <yloc>96</yloc>
      <draw>Y</draw>
    </GUI>
  </step>

  <step>
    <name>Lookup_Pelicula</name>
    <type>DBLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Stage</connection>
    <cache>N</cache>
    <cache_load_all>N</cache_load_all>
    <cache_size>0</cache_size>
    <lookup>
      <schema>dw</schema>
      <table>dim_pelicula</table>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
      <key>
        <name>codigo_pelicula</name>
        <field>codigo_pelicula</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>pelicula_key</name>
        <rename>pelicula_key</rename>
        <default/>
        <type>Integer</type>
      </value>
    </lookup>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>720</xloc>
      <yloc>96</yloc>
      <draw>Y</draw>
    </GUI>
  </step>

  <step>
    <name>Lookup_Fecha_Corte</name>
    <type>DBLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Stage</connection>
    <cache>N</cache>
    <cache_load_all>N</cache_load_all>
    <cache_size>0</cache_size>
    <lookup>
      <schema>dw</schema>
      <table>dim_tiempo</table>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
      <key>
        <name>fecha_corte</name>
        <field>fecha</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>fecha_key</name>
        <rename>fecha_corte_key</rename>
        <default/>
        <type>Integer</type>
      </value>
    </lookup>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>880</xloc>
      <yloc>96</yloc>
      <draw>Y</draw>
    </GUI>
  </step>

  <step>
    <name>Cargar_Fact_Disponibilidad</name>
    <type>InsertUpdate</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Stage</connection>
    <commit>1000</commit>
    <update_bypassed>N</update_bypassed>
    <lookup>
      <schema>dw</schema>
      <table>fact_disponibilidad</table>
      <key>
        <name>fecha_corte_key</name>
        <field>fecha_corte_key</field>
        <condition>=</condition>
        <name2/>
      </key>
      <key>
        <name>sucursal_key</name>
        <field>sucursal_key</field>
        <condition>=</condition>
        <name2/>
      </key>
      <key>
        <name>pelicula_key</name>
        <field>pelicula_key</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>funciones_disponibles</name>
        <rename>funciones_disponibles</rename>
        <update>Y</update>
      </value>
      <value>
        <name>funciones_minimas</name>
        <rename>funciones_minimas</rename>
        <update>Y</update>
      </value>
      <value>
        <name>exceso_programacion</name>
        <rename>exceso_programacion</rename>
        <update>Y</update>
      </value>
      <value>
        <name>deficit_programacion</name>
        <rename>deficit_programacion</rename>
        <update>Y</update>
      </value>
      <value>
        <name>fecha_ultimo_movimiento</name>
        <rename>fecha_ultimo_movimiento</rename>
        <update>Y</update>
      </value>
      <value>
        <name>fecha_corte_key</name>
        <rename>fecha_corte_key</rename>
        <update>N</update>
      </value>
      <value>
        <name>sucursal_key</name>
        <rename>sucursal_key</rename>
        <update>N</update>
      </value>
      <value>
        <name>pelicula_key</name>
        <rename>pelicula_key</rename>
        <update>N</update>
      </value>
    </lookup>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>1040</xloc>
      <yloc>96</yloc>
      <draw>Y</draw>
    </GUI>
  </step>

  <step_error_handling>
  </step_error_handling>
  <slave-step-copy-partition-distribution>
  </slave-step-copy-partition-distribution>
  <slave_transformation>N</slave_transformation>
  <attributes/>
</transformation>
