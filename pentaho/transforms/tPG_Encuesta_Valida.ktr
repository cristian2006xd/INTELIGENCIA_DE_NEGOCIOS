<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>PG_Encuesta_Valida</name>
    <description>Extrae encuestas de satisfaccion desde PostgreSQL (gestion), limpia/valida/homologa y carga staging. Rechazos a audit.etl_rechazo.</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
    <parameters>
    </parameters>
    <log>
      <trans-log-table>
        <connection/><schema/><table/><size_limit_lines/><interval/><timeout_days/>
      </trans-log-table>
      <perf-log-table>
        <connection/><schema/><table/><interval/><timeout_days/>
      </perf-log-table>
      <channel-log-table>
        <connection/><schema/><table/><timeout_days/>
      </channel-log-table>
      <step-log-table>
        <connection/><schema/><table/><timeout_days/>
      </step-log-table>
      <metrics-log-table>
        <connection/><schema/><table/><timeout_days/>
      </metrics-log-table>
    </log>
    <maxdate><connection/><table/><field/><offset>0.0</offset><maxdiff>0.0</maxdiff></maxdate>
    <size_rowset>10000</size_rowset>
    <sleep_time_empty>50</sleep_time_empty>
    <sleep_time_full>50</sleep_time_full>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <using_thread_priorities>Y</using_thread_priorities>
    <capture_step_performance>N</capture_step_performance>
    <step_performance_capturing_delay>1000</step_performance_capturing_delay>
    <step_performance_capturing_size_limit>100</step_performance_capturing_size_limit>
    <dependencies>
    </dependencies>
    <partitionschemas>
    </partitionschemas>
    <slaveservers>
    </slaveservers>
    <clusterschemas>
    </clusterschemas>
    <created_user>-</created_user>
    <created_date>2026/07/17 08:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/07/17 08:00:00.000</modified_date>
    <key_for_session_key/>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop><from>Leer_Encuesta</from><to>Filtro_Doc</to><enabled>Y</enabled></hop>
    <hop><from>Filtro_Doc</from><to>Filtro_Puntuacion</to><enabled>Y</enabled></hop>
    <hop><from>Filtro_Doc</from><to>Rechazo_Regex</to><enabled>Y</enabled></hop>
    <hop><from>Filtro_Puntuacion</from><to>Buffer_Validos</to><enabled>Y</enabled></hop>
    <hop><from>Buffer_Validos</from><to>Homologar_Satisfaccion</to><enabled>Y</enabled></hop>
    <hop><from>Filtro_Puntuacion</from><to>Rechazo_Regex</to><enabled>Y</enabled></hop>
    <hop><from>Homologar_Satisfaccion</from><to>Lookup_Sucursal</to><enabled>Y</enabled></hop>
    <hop><from>Leer_Sucursales</from><to>Lookup_Sucursal</to><enabled>Y</enabled></hop>
    <hop><from>Lookup_Sucursal</from><to>Filtro_Sucursal</to><enabled>Y</enabled></hop>
    <hop><from>Filtro_Sucursal</from><to>Stage_Encuesta_Valida</to><enabled>Y</enabled></hop>
    <hop><from>Filtro_Sucursal</from><to>Rechazo_Sucursal</to><enabled>Y</enabled></hop>
  </order>

  <step>
    <name>Leer_Encuesta</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Gestion_PG</connection>
    <sql>SELECT
  id_encuesta,
  fecha,
  UPPER(TRIM(codigo_sucursal)) AS sucursal_norm,
  documento_cliente,
  puntuacion,
  tiempo_espera_minutos,
  TRIM(comentario) AS comentario_limpio,
  CASE WHEN documento_cliente ~ '^[0-9]{10}$' THEN 'Y' ELSE 'N' END AS doc_valido,
  CASE WHEN puntuacion BETWEEN 1 AND 5 THEN 'Y' ELSE 'N' END AS puntuacion_valida,
  CONCAT_WS('; ',
    CASE WHEN documento_cliente ~ '^[0-9]{10}$' THEN NULL ELSE 'documento_cliente no tiene 10 digitos numericos' END,
    CASE WHEN puntuacion BETWEEN 1 AND 5 THEN NULL ELSE 'puntuacion fuera del rango 1-5' END
  ) AS descripcion_error_regex,
  'GESTION_PG' AS sistema_origen,
  'ETL_PDI' AS usuario_carga,
  now() AS fecha_carga,
  'GESTION_PG' AS fuente,
  'ENCUESTA_SATISFACCION' AS entidad,
  'FORMATO_INVALIDO' AS tipo_error_regex,
  'SUCURSAL_NO_ENCONTRADA' AS tipo_error_sucursal,
  'El codigo_sucursal no existe en la tabla sucursal' AS descripcion_error_sucursal
FROM gestion.encuesta_satisfaccion</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>80</xloc>
      <yloc>96</yloc>
      <draw>Y</draw>
    </GUI>
  </step>

  <step>
    <name>Filtro_Doc</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Filtro_Puntuacion</send_true_to>
    <send_false_to>Rechazo_Regex</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <conditions>
        </conditions>
        <leftvalue>doc_valido</leftvalue>
        <function>=</function>
        <rightvalue2/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>Y</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask>String</mask>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>240</xloc>
      <yloc>96</yloc>
      <draw>Y</draw>
    </GUI>
  </step>

  <step>
    <name>Filtro_Puntuacion</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Buffer_Validos</send_true_to>
    <send_false_to>Rechazo_Regex</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <conditions>
        </conditions>
        <leftvalue>puntuacion_valida</leftvalue>
        <function>=</function>
        <rightvalue2/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>Y</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask>String</mask>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>400</xloc>
      <yloc>96</yloc>
      <draw>Y</draw>
    </GUI>
  </step>

  <step>
    <name>Buffer_Validos</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>480</xloc>
      <yloc>200</yloc>
      <draw>Y</draw>
    </GUI>
  </step>

  <step>
    <name>Homologar_Satisfaccion</name>
    <type>ValueMapper</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <field_to_use>puntuacion</field_to_use>
    <target_field>categoria_satisfaccion</target_field>
    <non_match_default>SIN_CLASIFICAR</non_match_default>
    <fields>
      <field><source_value>1</source_value><target_value>Insatisfecho</target_value></field>
      <field><source_value>2</source_value><target_value>Insatisfecho</target_value></field>
      <field><source_value>3</source_value><target_value>Neutral</target_value></field>
      <field><source_value>4</source_value><target_value>Satisfecho</target_value></field>
      <field><source_value>5</source_value><target_value>Satisfecho</target_value></field>
    </fields>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>560</xloc>
      <yloc>96</yloc>
      <draw>Y</draw>
    </GUI>
  </step>

  <step>
    <name>Leer_Sucursales</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Gestion_PG</connection>
    <sql>SELECT codigo_sucursal, nombre_oficial FROM gestion.sucursal</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>720</xloc>
      <yloc>240</yloc>
      <draw>Y</draw>
    </GUI>
  </step>

  <step>
    <name>Lookup_Sucursal</name>
    <type>StreamLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <from>Leer_Sucursales</from>
    <input_sorted>N</input_sorted>
    <preserve_memory>Y</preserve_memory>
    <sorted_list>N</sorted_list>
    <integer_pair>N</integer_pair>
    <lookup>
      <key>
        <name>sucursal_norm</name>
        <field>codigo_sucursal</field>
      </key>
      <value>
        <name>nombre_oficial</name>
        <rename>nombre_sucursal</rename>
        <default/>
        <type>String</type>
      </value>
    </lookup>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>720</xloc>
      <yloc>96</yloc>
      <draw>Y</draw>
    </GUI>
  </step>

  <step>
    <name>Filtro_Sucursal</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Stage_Encuesta_Valida</send_true_to>
    <send_false_to>Rechazo_Sucursal</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <conditions>
        </conditions>
        <leftvalue>nombre_sucursal</leftvalue>
        <function>IS NOT NULL</function>
        <rightvalue2/>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>880</xloc>
      <yloc>96</yloc>
      <draw>Y</draw>
    </GUI>
  </step>

  <step>
    <name>Rechazo_Regex</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Stage</connection>
    <schema>audit</schema>
    <table>etl_rechazo</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
      <field><column_name>fuente</column_name><stream_name>fuente</stream_name></field>
      <field><column_name>entidad</column_name><stream_name>entidad</stream_name></field>
      <field><column_name>clave_origen</column_name><stream_name>id_encuesta</stream_name></field>
      <field><column_name>tipo_error</column_name><stream_name>tipo_error_regex</stream_name></field>
      <field><column_name>descripcion_error</column_name><stream_name>descripcion_error_regex</stream_name></field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>400</xloc>
      <yloc>260</yloc>
      <draw>Y</draw>
    </GUI>
  </step>

  <step>
    <name>Rechazo_Sucursal</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Stage</connection>
    <schema>audit</schema>
    <table>etl_rechazo</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
      <field><column_name>fuente</column_name><stream_name>fuente</stream_name></field>
      <field><column_name>entidad</column_name><stream_name>entidad</stream_name></field>
      <field><column_name>clave_origen</column_name><stream_name>id_encuesta</stream_name></field>
      <field><column_name>tipo_error</column_name><stream_name>tipo_error_sucursal</stream_name></field>
      <field><column_name>descripcion_error</column_name><stream_name>descripcion_error_sucursal</stream_name></field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>880</xloc>
      <yloc>260</yloc>
      <draw>Y</draw>
    </GUI>
  </step>

  <step>
    <name>Stage_Encuesta_Valida</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Stage</connection>
    <schema>stg</schema>
    <table>pg_encuesta_valida</table>
    <commit>1000</commit>
    <truncate>Y</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
      <field><column_name>id_encuesta_origen</column_name><stream_name>id_encuesta</stream_name></field>
      <field><column_name>fecha</column_name><stream_name>fecha</stream_name></field>
      <field><column_name>codigo_sucursal</column_name><stream_name>sucursal_norm</stream_name></field>
      <field><column_name>nombre_sucursal</column_name><stream_name>nombre_sucursal</stream_name></field>
      <field><column_name>documento_cliente</column_name><stream_name>documento_cliente</stream_name></field>
      <field><column_name>puntuacion</column_name><stream_name>puntuacion</stream_name></field>
      <field><column_name>categoria_satisfaccion</column_name><stream_name>categoria_satisfaccion</stream_name></field>
      <field><column_name>tiempo_espera_minutos</column_name><stream_name>tiempo_espera_minutos</stream_name></field>
      <field><column_name>comentario</column_name><stream_name>comentario_limpio</stream_name></field>
      <field><column_name>sistema_origen</column_name><stream_name>sistema_origen</stream_name></field>
      <field><column_name>usuario_carga</column_name><stream_name>usuario_carga</stream_name></field>
      <field><column_name>fecha_carga</column_name><stream_name>fecha_carga</stream_name></field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>1040</xloc>
      <yloc>96</yloc>
      <draw>Y</draw>
    </GUI>
  </step>

  <step_error_handling>
  </step_error_handling>
  <slave-step-copy-partition-distribution>
  </slave-step-copy-partition-distribution>
  <slave_transformation>N</slave_transformation>
  <attributes/>
</transformation>
