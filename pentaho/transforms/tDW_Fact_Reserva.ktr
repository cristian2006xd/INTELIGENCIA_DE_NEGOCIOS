<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>tDW_Fact_Reserva</name>
    <description>Carga la tabla de hechos de reservas resolviendo las llaves subrogadas de cada dimension.</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
    <parameters>
    </parameters>
    <log>
      <trans-log-table>
        <connection/><schema/><table/><size_limit_lines/><interval/><timeout_days/>
      </trans-log-table>
      <perf-log-table>
        <connection/><schema/><table/><interval/><timeout_days/>
      </perf-log-table>
      <channel-log-table>
        <connection/><schema/><table/><timeout_days/>
      </channel-log-table>
      <step-log-table>
        <connection/><schema/><table/><timeout_days/>
      </step-log-table>
      <metrics-log-table>
        <connection/><schema/><table/><timeout_days/>
      </metrics-log-table>
    </log>
    <maxdate><connection/><table/><field/><offset>0.0</offset><maxdiff>0.0</maxdiff></maxdate>
    <size_rowset>10000</size_rowset>
    <sleep_time_empty>50</sleep_time_empty>
    <sleep_time_full>50</sleep_time_full>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <using_thread_priorities>Y</using_thread_priorities>
    <capture_step_performance>N</capture_step_performance>
    <step_performance_capturing_delay>1000</step_performance_capturing_delay>
    <step_performance_capturing_size_limit>100</step_performance_capturing_size_limit>
    <dependencies>
    </dependencies>
    <partitionschemas>
    </partitionschemas>
    <slaveservers>
    </slaveservers>
    <clusterschemas>
    </clusterschemas>
    <created_user>-</created_user>
    <created_date>2026/07/22 08:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/07/22 08:00:00.000</modified_date>
    <key_for_session_key/>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop><from>Leer_Reserva_Detalle</from><to>Homologar_Sucursal</to><enabled>Y</enabled></hop>
    <hop><from>Homologar_Sucursal</from><to>Lookup_Sucursal</to><enabled>Y</enabled></hop>
    <hop><from>Lookup_Sucursal</from><to>Lookup_Pelicula</to><enabled>Y</enabled></hop>
    <hop><from>Lookup_Pelicula</from><to>Lookup_Cliente</to><enabled>Y</enabled></hop>
    <hop><from>Lookup_Cliente</from><to>Lookup_Canal</to><enabled>Y</enabled></hop>
    <hop><from>Lookup_Canal</from><to>Lookup_Estado</to><enabled>Y</enabled></hop>
    <hop><from>Lookup_Estado</from><to>Cargar_Fact_Reserva</to><enabled>Y</enabled></hop>
  </order>

  <step>
    <name>Leer_Reserva_Detalle</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Cine_MySQL</connection>
    <sql>SELECT
  r.numero_reserva,
  d.linea,
  CAST(DATE_FORMAT(r.fecha_hora, '%Y%m%d') AS UNSIGNED) AS fecha_reserva_key,
  d.codigo_pelicula,
  r.documento_cliente,
  TRIM(UPPER(r.sucursal_origen)) AS sucursal_norm,
  TRIM(UPPER(r.canal_reserva)) AS canal_norm,
  r.estado,
  d.tipo_asiento,
  d.cantidad_asientos,
  r.descuento
FROM reserva r
JOIN detalle_reserva d ON d.numero_reserva = r.numero_reserva
WHERE r.estado = 'CONFIRMADA'</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>80</xloc>
      <yloc>96</yloc>
      <draw>Y</draw>
    </GUI>
  </step>

  <step>
    <name>Homologar_Sucursal</name>
    <type>ValueMapper</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <field_to_use>sucursal_norm</field_to_use>
    <target_field>codigo_sucursal</target_field>
    <non_match_default>SIN_HOMOLOGAR</non_match_default>
    <fields>
      <field><source_value>CENTRO</source_value><target_value>CENTRO</target_value></field>
      <field><source_value>CINE CENTRO</source_value><target_value>CENTRO</target_value></field>
      <field><source_value>NORTE</source_value><target_value>NORTE</target_value></field>
      <field><source_value>CINE NORTE</source_value><target_value>NORTE</target_value></field>
      <field><source_value>SUR</source_value><target_value>SUR</target_value></field>
      <field><source_value>CINE SUR</source_value><target_value>SUR</target_value></field>
      <field><source_value>VALLE</source_value><target_value>VALLE</target_value></field>
      <field><source_value>CINE VALLE</source_value><target_value>VALLE</target_value></field>
    </fields>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>240</xloc>
      <yloc>96</yloc>
      <draw>Y</draw>
    </GUI>
  </step>

  <step>
    <name>Lookup_Sucursal</name>
    <type>DBLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Stage</connection>
    <cache>N</cache>
    <cache_load_all>N</cache_load_all>
    <cache_size>0</cache_size>
    <lookup>
      <schema>dw</schema>
      <table>dim_sucursal</table>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
      <key>
        <name>codigo_sucursal</name>
        <field>codigo_sucursal</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>sucursal_key</name>
        <rename>sucursal_key</rename>
        <default/>
        <type>Integer</type>
      </value>
    </lookup>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>400</xloc>
      <yloc>96</yloc>
      <draw>Y</draw>
