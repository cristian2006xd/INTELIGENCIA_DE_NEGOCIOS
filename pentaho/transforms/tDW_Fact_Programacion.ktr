<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>tDW_Fact_Programacion</name>
    <description>Carga dw.fact_programacion desde stg.excel_programacion, resolviendo las llaves subrogadas de fecha (programacion, estreno, fin de exhibicion), sucursal, pelicula, distribuidora y estado de entrega.</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
    <parameters>
    </parameters>
    <log>
      <trans-log-table>
        <connection/><schema/><table/><size_limit_lines/><interval/><timeout_days/>
      </trans-log-table>
      <perf-log-table>
        <connection/><schema/><table/><interval/><timeout_days/>
      </perf-log-table>
      <channel-log-table>
        <connection/><schema/><table/><timeout_days/>
      </channel-log-table>
      <step-log-table>
        <connection/><schema/><table/><timeout_days/>
      </step-log-table>
      <metrics-log-table>
        <connection/><schema/><table/><timeout_days/>
      </metrics-log-table>
    </log>
    <maxdate><connection/><table/><field/><offset>0.0</offset><maxdiff>0.0</maxdiff></maxdate>
    <size_rowset>10000</size_rowset>
    <sleep_time_empty>50</sleep_time_empty>
    <sleep_time_full>50</sleep_time_full>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <using_thread_priorities>Y</using_thread_priorities>
    <capture_step_performance>N</capture_step_performance>
    <step_performance_capturing_delay>1000</step_performance_capturing_delay>
    <step_performance_capturing_size_limit>100</step_performance_capturing_size_limit>
    <dependencies>
    </dependencies>
    <partitionschemas>
    </partitionschemas>
    <slaveservers>
    </slaveservers>
    <clusterschemas>
    </clusterschemas>
    <created_user>-</created_user>
    <created_date>2026/07/28 08:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/07/28 08:00:00.000</modified_date>
    <key_for_session_key/>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop><from>Leer_Programacion</from><to>Lookup_Fecha_Programacion</to><enabled>Y</enabled></hop>
    <hop><from>Lookup_Fecha_Programacion</from><to>Lookup_Fecha_Estreno</to><enabled>Y</enabled></hop>
    <hop><from>Lookup_Fecha_Estreno</from><to>Lookup_Fecha_Fin</to><enabled>Y</enabled></hop>
    <hop><from>Lookup_Fecha_Fin</from><to>Lookup_Sucursal</to><enabled>Y</enabled></hop>
    <hop><from>Lookup_Sucursal</from><to>Lookup_Pelicula</to><enabled>Y</enabled></hop>
    <hop><from>Lookup_Pelicula</from><to>Lookup_Distribuidora</to><enabled>Y</enabled></hop>
    <hop><from>Lookup_Distribuidora</from><to>Lookup_Estado_Entrega</to><enabled>Y</enabled></hop>
    <hop><from>Lookup_Estado_Entrega</from><to>Cargar_Fact_Programacion</to><enabled>Y</enabled></hop>
  </order>

  <step>
    <name>Leer_Programacion</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Stage</connection>
    <sql>SELECT
  numero_programacion,
  fecha_programacion,
  fecha_estreno_sala,
  fecha_fin_exhibicion,
  codigo_sucursal,
  codigo_pelicula,
  codigo_distribuidora,
  numero_copia,
  funciones_programadas,
  costo_proyeccion_unitario,
  subtotal_bruto,
  porcentaje_descuento,
  valor_descuento,
  valor_neto,
  estado_entrega_copia,
  (fecha_estreno_sala - fecha_programacion) AS dias_hasta_estreno,
  (fecha_fin_exhibicion - fecha_programacion) AS dias_hasta_fin_exhibicion
FROM stg.excel_programacion</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>80</xloc>
      <yloc>96</yloc>
      <draw>Y</draw>
    </GUI>
  </step>

