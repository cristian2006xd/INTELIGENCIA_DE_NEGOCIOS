    <lookup>
      <schema>dw</schema>
      <table>fact_satisfaccion</table>
      <key>
        <name>id_encuesta_origen</name>
        <field>id_encuesta_origen</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>fecha_encuesta_key</name>
        <rename>fecha_encuesta_key</rename>
        <update>Y</update>
      </value>
      <value>
        <name>sucursal_key</name>
        <rename>sucursal_key</rename>
        <update>Y</update>
      </value>
      <value>
        <name>cliente_key</name>
        <rename>cliente_key</rename>
        <update>Y</update>
      </value>
      <value>
        <name>categoria_satisfaccion_key</name>
        <rename>categoria_satisfaccion_key</rename>
        <update>Y</update>
      </value>
      <value>
        <name>puntuacion</name>
        <rename>puntuacion</rename>
        <update>Y</update>
      </value>
      <value>
        <name>tiempo_espera_minutos</name>
        <rename>tiempo_espera_minutos</rename>
        <update>Y</update>
      </value>
      <value>
        <name>comentario</name>
        <rename>comentario</rename>
        <update>Y</update>
      </value>
      <value>
        <name>id_encuesta_origen</name>
        <rename>id_encuesta_origen</rename>
        <update>N</update>
      </value>
    </lookup>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
