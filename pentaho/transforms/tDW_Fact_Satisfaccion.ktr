<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>tDW_Fact_Satisfaccion</name>
    <description>Carga dw.fact_satisfaccion desde stg.pg_encuesta_valida, resolviendo claves sustitutas de fecha, sucursal, cliente y categoria de satisfaccion.</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
    <parameters>
    </parameters>
    <log>
      <trans-log-table>
        <connection/><schema/><table/><size_limit_lines/><interval/><timeout_days/>
      </trans-log-table>
      <perf-log-table>
        <connection/><schema/><table/><interval/><timeout_days/>
      </perf-log-table>
      <channel-log-table>
        <connection/><schema/><table/><timeout_days/>
      </channel-log-table>
      <step-log-table>
        <connection/><schema/><table/><timeout_days/>
      </step-log-table>
      <metrics-log-table>
        <connection/><schema/><table/><timeout_days/>
      </metrics-log-table>
    </log>
    <maxdate><connection/><table/><field/><offset>0.0</offset><maxdiff>0.0</maxdiff></maxdate>
    <size_rowset>10000</size_rowset>
    <sleep_time_empty>50</sleep_time_empty>
    <sleep_time_full>50</sleep_time_full>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <using_thread_priorities>Y</using_thread_priorities>
    <capture_step_performance>N</capture_step_performance>
    <step_performance_capturing_delay>1000</step_performance_capturing_delay>
    <step_performance_capturing_size_limit>100</step_performance_capturing_size_limit>
    <dependencies>
    </dependencies>
    <partitionschemas>
    </partitionschemas>
    <slaveservers>
    </slaveservers>
    <clusterschemas>
    </clusterschemas>
    <created_user>-</created_user>
    <created_date>2026/07/24 08:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/07/24 08:00:00.000</modified_date>
    <key_for_session_key/>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop><from>Leer_Encuesta_Valida</from><to>Lookup_Tiempo</to><enabled>Y</enabled></hop>
    <hop><from>Lookup_Tiempo</from><to>Lookup_Sucursal</to><enabled>Y</enabled></hop>
    <hop><from>Lookup_Sucursal</from><to>Lookup_Cliente</to><enabled>Y</enabled></hop>
    <hop><from>Lookup_Cliente</from><to>Lookup_Categoria_Satisfaccion</to><enabled>Y</enabled></hop>
    <hop><from>Lookup_Categoria_Satisfaccion</from><to>Cargar_Fact_Satisfaccion</to><enabled>Y</enabled></hop>
  </order>

  <step>
    <name>Leer_Encuesta_Valida</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Stage</connection>
    <sql>SELECT
  id_encuesta_origen,
  fecha,
  codigo_sucursal,
  documento_cliente,
  COALESCE(categoria_satisfaccion, 'SIN_CLASIFICAR') AS categoria_satisfaccion,
  puntuacion,
  tiempo_espera_minutos,
  comentario
FROM stg.pg_encuesta_valida</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>80</xloc>
      <yloc>96</yloc>
      <draw>Y</draw>
    </GUI>
  </step>

  <step>
    <name>Lookup_Tiempo</name>
    <type>DBLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Stage</connection>
    <cache>N</cache>
    <cache_load_all>N</cache_load_all>
    <cache_size>0</cache_size>
    <lookup>
      <schema>dw</schema>
      <table>dim_tiempo</table>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
      <key>
        <name>fecha</name>
        <field>fecha</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>fecha_key</name>
        <rename>fecha_encuesta_key</rename>
        <default/>
        <type>Integer</type>
      </value>
    </lookup>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>240</xloc>
      <yloc>96</yloc>
      <draw>Y</draw>
    </GUI>
  </step>

  <step>
    <name>Lookup_Sucursal</name>
    <type>DBLookup</type>
    <description/>
    <distribute>Y</distribute>
