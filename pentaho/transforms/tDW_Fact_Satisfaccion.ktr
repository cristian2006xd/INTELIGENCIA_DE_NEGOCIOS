    <GUI>
      <xloc>560</xloc>
      <yloc>96</yloc>
      <draw>Y</draw>
    </GUI>
  </step>

  <step>
    <name>Lookup_Categoria_Satisfaccion</name>
    <type>DBLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Stage</connection>
    <cache>Y</cache>
    <cache_load_all>Y</cache_load_all>
    <cache_size>0</cache_size>
    <lookup>
      <schema>dw</schema>
      <table>dim_categoria_satisfaccion</table>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
      <key>
        <name>categoria_satisfaccion</name>
        <field>categoria_satisfaccion</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
