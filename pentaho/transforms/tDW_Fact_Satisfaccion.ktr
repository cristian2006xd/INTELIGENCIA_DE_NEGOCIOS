  </step>

  <step>
    <name>Lookup_Cliente</name>
    <type>DBLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Stage</connection>
    <cache>N</cache>
    <cache_load_all>N</cache_load_all>
    <cache_size>0</cache_size>
    <lookup>
      <schema>dw</schema>
      <table>dim_cliente</table>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
      <key>
        <name>documento_cliente</name>
        <field>documento</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>cliente_key</name>
        <rename>cliente_key</rename>
