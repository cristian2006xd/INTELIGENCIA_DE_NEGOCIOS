<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>tDW_Sucursal</name>
    <description>Carga la dimension sucursal del cubo de reservas desde PostgreSQL (gestion).</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
    <parameters>
    </parameters>
    <log>
      <trans-log-table>
        <connection/><schema/><table/><size_limit_lines/><interval/><timeout_days/>
      </trans-log-table>
      <perf-log-table>
        <connection/><schema/><table/><interval/><timeout_days/>
      </perf-log-table>
      <channel-log-table>
        <connection/><schema/><table/><timeout_days/>
      </channel-log-table>
      <step-log-table>
        <connection/><schema/><table/><timeout_days/>
      </step-log-table>
      <metrics-log-table>
        <connection/><schema/><table/><timeout_days/>
      </metrics-log-table>
    </log>
    <maxdate><connection/><table/><field/><offset>0.0</offset><maxdiff>0.0</maxdiff></maxdate>
    <size_rowset>10000</size_rowset>
    <sleep_time_empty>50</sleep_time_empty>
    <sleep_time_full>50</sleep_time_full>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <using_thread_priorities>Y</using_thread_priorities>
    <capture_step_performance>N</capture_step_performance>
    <step_performance_capturing_delay>1000</step_performance_capturing_delay>
    <step_performance_capturing_size_limit>100</step_performance_capturing_size_limit>
    <dependencies>
    </dependencies>
    <partitionschemas>
    </partitionschemas>
    <slaveservers>
    </slaveservers>
    <clusterschemas>
    </clusterschemas>
    <created_user>-</created_user>
    <created_date>2026/07/22 08:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/07/22 08:00:00.000</modified_date>
    <key_for_session_key/>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop><from>Leer_Sucursales</from><to>Cargar_Dim_Sucursal</to><enabled>Y</enabled></hop>
  </order>

  <step>
    <name>Leer_Sucursales</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Gestion_PG</connection>
    <sql>SELECT
  s.codigo_sucursal,
  s.nombre_oficial AS nombre_sucursal,
  z.nombre AS zona,
  s.ciudad,
  s.direccion
FROM gestion.sucursal s
LEFT JOIN gestion.zona z ON z.codigo_zona = s.codigo_zona</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>144</xloc>
      <yloc>96</yloc>
      <draw>Y</draw>
    </GUI>
  </step>

  <step>
    <name>Cargar_Dim_Sucursal</name>
    <type>InsertUpdate</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Stage</connection>
    <commit>1000</commit>
    <update_bypassed>N</update_bypassed>
    <lookup>
      <schema>dw</schema>
      <table>dim_sucursal</table>
      <key>
        <name>codigo_sucursal</name>
        <field>codigo_sucursal</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>nombre_sucursal</name>
        <rename>nombre_sucursal</rename>
        <update>Y</update>
      </value>
      <value>
        <name>zona</name>
        <rename>zona</rename>
        <update>Y</update>
      </value>
      <value>
        <name>ciudad</name>
        <rename>ciudad</rename>
        <update>Y</update>
      </value>
      <value>
        <name>direccion</name>
        <rename>direccion</rename>
        <update>Y</update>
      </value>
      <value>
        <name>codigo_sucursal</name>
        <rename>codigo_sucursal</rename>
        <update>N</update>
      </value>
    </lookup>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>384</xloc>
      <yloc>96</yloc>
      <draw>Y</draw>
    </GUI>
  </step>

  <step_error_handling>
  </step_error_handling>
  <slave-step-copy-partition-distribution>
  </slave-step-copy-partition-distribution>
  <slave_transformation>N</slave_transformation>
  <attributes/>
</transformation>
