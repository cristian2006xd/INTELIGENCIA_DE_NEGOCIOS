<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>tDW_Pelicula</name>
    <description>Carga la dimension pelicula del cubo de reservas desde staging.</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
    <parameters>
    </parameters>
    <log>
      <trans-log-table>
        <connection/><schema/><table/><size_limit_lines/><interval/><timeout_days/>
      </trans-log-table>
      <perf-log-table>
        <connection/><schema/><table/><interval/><timeout_days/>
      </perf-log-table>
      <channel-log-table>
        <connection/><schema/><table/><timeout_days/>
      </channel-log-table>
      <step-log-table>
        <connection/><schema/><table/><timeout_days/>
      </step-log-table>
      <metrics-log-table>
        <connection/><schema/><table/><timeout_days/>
      </metrics-log-table>
    </log>
    <maxdate><connection/><table/><field/><offset>0.0</offset><maxdiff>0.0</maxdiff></maxdate>
    <size_rowset>10000</size_rowset>
    <sleep_time_empty>50</sleep_time_empty>
    <sleep_time_full>50</sleep_time_full>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <using_thread_priorities>Y</using_thread_priorities>
    <capture_step_performance>N</capture_step_performance>
    <step_performance_capturing_delay>1000</step_performance_capturing_delay>
    <step_performance_capturing_size_limit>100</step_performance_capturing_size_limit>
    <dependencies>
    </dependencies>
    <partitionschemas>
    </partitionschemas>
    <slaveservers>
    </slaveservers>
    <clusterschemas>
    </clusterschemas>
    <created_user>-</created_user>
    <created_date>2026/07/22 08:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/07/22 08:00:00.000</modified_date>
    <key_for_session_key/>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop><from>Leer_Peliculas</from><to>Cargar_Dim_Pelicula</to><enabled>Y</enabled></hop>
  </order>

  <step>
    <name>Leer_Peliculas</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Stage</connection>
    <sql>SELECT
  p.codigo_pelicula,
  p.titulo,
  p.codigo_genero,
  g.nombre_genero AS genero,
  p.codigo_estudio,
  e.nombre_estudio AS estudio,
  p.formato,
  p.clasificacion,
  p.costo_proyeccion_referencia,
  p.tarifa_referencia_sala
FROM stg.mysql_pelicula p
LEFT JOIN stg.mysql_genero g ON g.codigo_genero = p.codigo_genero
LEFT JOIN stg.mysql_estudio e ON e.codigo_estudio = p.codigo_estudio</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>144</xloc>
      <yloc>96</yloc>
      <draw>Y</draw>
    </GUI>
  </step>

  <step>
    <name>Cargar_Dim_Pelicula</name>
    <type>InsertUpdate</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Stage</connection>
    <commit>1000</commit>
    <update_bypassed>N</update_bypassed>
    <lookup>
      <schema>dw</schema>
      <table>dim_pelicula</table>
      <key>
        <name>codigo_pelicula</name>
        <field>codigo_pelicula</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>titulo</name>
        <rename>titulo</rename>
        <update>Y</update>
      </value>
      <value>
        <name>codigo_genero</name>
        <rename>codigo_genero</rename>
        <update>Y</update>
      </value>
      <value>
        <name>genero</name>
        <rename>genero</rename>
        <update>Y</update>
      </value>
      <value>
        <name>codigo_estudio</name>
        <rename>codigo_estudio</rename>
        <update>Y</update>
      </value>
      <value>
        <name>estudio</name>
        <rename>estudio</rename>
        <update>Y</update>
      </value>
      <value>
        <name>formato</name>
        <rename>formato</rename>
        <update>Y</update>
      </value>
      <value>
        <name>clasificacion</name>
        <rename>clasificacion</rename>
        <update>Y</update>
      </value>
      <value>
        <name>costo_proyeccion_referencia</name>
        <rename>costo_proyeccion_referencia</rename>
        <update>Y</update>
      </value>
      <value>
        <name>tarifa_referencia_sala</name>
        <rename>tarifa_referencia_sala</rename>
        <update>Y</update>
      </value>
      <value>
        <name>codigo_pelicula</name>
        <rename>codigo_pelicula</rename>
        <update>N</update>
      </value>
    </lookup>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>384</xloc>
      <yloc>96</yloc>
      <draw>Y</draw>
    </GUI>
  </step>

  <step_error_handling>
  </step_error_handling>
  <slave-step-copy-partition-distribution>
  </slave-step-copy-partition-distribution>
  <slave_transformation>N</slave_transformation>
  <attributes/>
</transformation>
