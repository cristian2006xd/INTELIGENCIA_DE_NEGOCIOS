<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>MySQL_Reserva_Valida</name>
    <description>Extrae reservas desde MySQL (cine), limpia/valida/homologa y carga staging. Rechazos a audit.etl_rechazo.</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
    <parameters>
    </parameters>
    <log>
      <trans-log-table>
        <connection/><schema/><table/><size_limit_lines/><interval/><timeout_days/>
      </trans-log-table>
      <perf-log-table>
        <connection/><schema/><table/><interval/><timeout_days/>
      </perf-log-table>
      <channel-log-table>
        <connection/><schema/><table/><timeout_days/>
      </channel-log-table>
      <step-log-table>
        <connection/><schema/><table/><timeout_days/>
      </step-log-table>
      <metrics-log-table>
        <connection/><schema/><table/><timeout_days/>
      </metrics-log-table>
    </log>
    <maxdate><connection/><table/><field/><offset>0.0</offset><maxdiff>0.0</maxdiff></maxdate>
    <size_rowset>10000</size_rowset>
    <sleep_time_empty>50</sleep_time_empty>
    <sleep_time_full>50</sleep_time_full>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <using_thread_priorities>Y</using_thread_priorities>
    <capture_step_performance>N</capture_step_performance>
    <step_performance_capturing_delay>1000</step_performance_capturing_delay>
    <step_performance_capturing_size_limit>100</step_performance_capturing_size_limit>
    <dependencies>
    </dependencies>
    <partitionschemas>
    </partitionschemas>
    <slaveservers>
    </slaveservers>
    <clusterschemas>
    </clusterschemas>
    <created_user>-</created_user>
    <created_date>2026/07/17 08:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/07/17 08:00:00.000</modified_date>
    <key_for_session_key/>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop><from>Leer_Reserva</from><to>Filtro_Estado</to><enabled>Y</enabled></hop>
    <hop><from>Filtro_Estado</from><to>Filtro_Doc</to><enabled>Y</enabled></hop>
    <hop><from>Filtro_Estado</from><to>Descartadas_Canceladas</to><enabled>Y</enabled></hop>
    <hop><from>Filtro_Doc</from><to>Filtro_Num</to><enabled>Y</enabled></hop>
    <hop><from>Filtro_Doc</from><to>Rechazo_Regex</to><enabled>Y</enabled></hop>
    <hop><from>Filtro_Num</from><to>Buffer_Validos</to><enabled>Y</enabled></hop>
    <hop><from>Buffer_Validos</from><to>Homologar_Sucursal</to><enabled>Y</enabled></hop>
    <hop><from>Filtro_Num</from><to>Rechazo_Regex</to><enabled>Y</enabled></hop>
    <hop><from>Homologar_Sucursal</from><to>Homologar_Canal</to><enabled>Y</enabled></hop>
    <hop><from>Homologar_Canal</from><to>Lookup_Cliente</to><enabled>Y</enabled></hop>
    <hop><from>Lookup_Cliente</from><to>Filtro_Cliente</to><enabled>Y</enabled></hop>
    <hop><from>Filtro_Cliente</from><to>Stage_Reserva_Valida</to><enabled>Y</enabled></hop>
    <hop><from>Filtro_Cliente</from><to>Rechazo_Cliente</to><enabled>Y</enabled></hop>
  </order>

  <step>
    <name>Leer_Reserva</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Cine_MySQL</connection>
    <sql>SELECT
  numero_reserva,
  fecha_hora,
  TRIM(UPPER(sucursal_origen)) AS sucursal_norm,
  documento_cliente,
  TRIM(UPPER(canal_reserva)) AS canal_norm,
  descuento,
  estado,
  CASE WHEN documento_cliente REGEXP '^[0-9]{10}$' THEN 'Y' ELSE 'N' END AS doc_valido,
  CASE WHEN numero_reserva REGEXP '^RES[0-9]{6}$' THEN 'Y' ELSE 'N' END AS num_valido,
  CONCAT_WS('; ',
    CASE WHEN documento_cliente REGEXP '^[0-9]{10}$' THEN NULL ELSE 'documento_cliente no tiene 10 digitos numericos' END,
    CASE WHEN numero_reserva REGEXP '^RES[0-9]{6}$' THEN NULL ELSE 'numero_reserva no cumple formato RESxxxxxx' END
  ) AS descripcion_error_regex,
  'CINE_MYSQL' AS sistema_origen,
  'ETL_PDI' AS usuario_carga,
  NOW() AS fecha_carga,
  'CINE_MYSQL' AS fuente,
  'RESERVA' AS entidad,
  'FORMATO_INVALIDO' AS tipo_error_regex,
  'CLIENTE_NO_ENCONTRADO' AS tipo_error_cliente,
  'El documento_cliente no existe en la tabla cliente' AS descripcion_error_cliente
FROM reserva</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>80</xloc>
      <yloc>96</yloc>
      <draw>Y</draw>
    </GUI>
  </step>

  <step>
    <name>Filtro_Estado</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Filtro_Doc</send_true_to>
    <send_false_to>Descartadas_Canceladas</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <conditions>
        </conditions>
        <leftvalue>estado</leftvalue>
        <function>=</function>
        <rightvalue2/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>CONFIRMADA</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask>String</mask>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>240</xloc>
      <yloc>96</yloc>
      <draw>Y</draw>
    </GUI>
  </step>

