  <step>
    <name>Homologar_Sucursal</name>
    <type>ValueMapper</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <field_to_use>sucursal_norm</field_to_use>
    <target_field>codigo_sucursal</target_field>
    <non_match_default>SIN_HOMOLOGAR</non_match_default>
    <fields>
      <field><source_value>CENTRO</source_value><target_value>CENTRO</target_value></field>
      <field><source_value>CINE CENTRO</source_value><target_value>CENTRO</target_value></field>
      <field><source_value>NORTE</source_value><target_value>NORTE</target_value></field>
      <field><source_value>CINE NORTE</source_value><target_value>NORTE</target_value></field>
      <field><source_value>SUR</source_value><target_value>SUR</target_value></field>
