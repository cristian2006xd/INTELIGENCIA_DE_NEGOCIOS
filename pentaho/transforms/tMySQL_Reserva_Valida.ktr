    <send_true_to>Filtro_Num</send_true_to>
    <send_false_to>Rechazo_Regex</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <conditions>
        </conditions>
        <leftvalue>doc_valido</leftvalue>
        <function>=</function>
        <rightvalue2/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>Y</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
